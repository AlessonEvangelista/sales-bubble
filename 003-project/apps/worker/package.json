    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5",
    "@bolha/observability": "*",
    "@opentelemetry/instrumentation": "^0.223.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8"
