{
  "name": "@bolha/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos compartilhados entre front e back (DTOs, schemas Zod, eventos WS/domínio, erros RFC 9457).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
