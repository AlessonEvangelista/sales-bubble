{
  "name": "@bolha/observability",
  "version": "0.0.0",
  "private": true,
  "description": "Observabilidade compartilhada (BV-108, ADR-0012): redaction de PII (puro, também no browser) e, em ./node, OpenTelemetry, logger pino e Sentry para api e worker.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./telemetry": {
      "types": "./dist/node/telemetry.d.ts",
      "default": "./dist/node/telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^11.6.0",
    "pino": "^10.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "rxjs": "^7.8.2"
  }
}
