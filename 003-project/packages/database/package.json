{
  "name": "@bolha/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seeds e adapters de repositório (implementam as portas do core-domain).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "node dist/seed/cli.js"
  },
  "dependencies": {
    "@bolha/contracts": "*",
    "@bolha/core-domain": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0"
  }
}
