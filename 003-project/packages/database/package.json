{
  "name": "@bolha/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seeds e adapters de repositório (implementam as portas do core-domain).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pii": {
      "types": "./dist/pii/index.d.ts",
      "default": "./dist/pii/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:seed": "node dist/seed/cli.js"
  },
  "dependencies": {
    "@bolha/core-domain": "*",
    "@bolha/contracts": "*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
